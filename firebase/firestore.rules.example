// TEMPLATE ONLY: review against the current production rules before deploying.
// These rules protect the Expo marketplace collections; they are not deployed by this repository.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSeller() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sellerStatus == 'approved';
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'role', 'sellerStatus', 'createdAt'
        ])
        && (
          (request.resource.data.role == 'customer'
            && !('sellerStatus' in request.resource.data))
          ||
          (request.resource.data.role == 'seller'
            && request.resource.data.sellerStatus == 'pending')
        );

      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();

      // Users cannot promote themselves to admin or seller by editing their profile.
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'email', 'photoURL', 'updatedAt']));

      allow delete: if isAdmin();
    }

    match /products/{productId} {
      // Public customers only read approved listings. Sellers can read their own listings.
      allow get, list: if resource.data.status == 'approved'
        || isAdmin()
        || (signedIn() && resource.data.sellerId == request.auth.uid);

      allow create: if isSeller()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.category is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.currency in ['USD', 'ZWL']
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'price', 'currency', 'category', 'sellerName', 'city',
          'imageUrl', 'sellerId', 'status', 'createdAt', 'updatedAt'
        ]);

      // Sellers may edit details, but cannot change owner or approval status.
      allow update: if isAdmin()
        || (isSeller()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'description', 'price', 'currency', 'category', 'sellerName', 'city', 'imageUrl', 'updatedAt']));

      allow delete: if isAdmin()
        || (isSeller()
          && resource.data.sellerId == request.auth.uid
          && resource.data.status != 'approved');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}