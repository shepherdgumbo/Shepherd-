rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /products/{sellerId}/{fileName} {
      // Product image URLs are public, as product listings are publicly browsable.
      allow read: if true;

      // Only an approved seller may upload or replace product images in their folder.
      allow create, update: if signedIn()
        && request.auth.uid == sellerId
        && firestore.get(/databases/(default)/documents/users/$(sellerId)).data.role == 'seller'
        && firestore.get(/databases/(default)/documents/users/$(sellerId)).data.sellerStatus == 'approved'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if signedIn() && request.auth.uid == sellerId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
